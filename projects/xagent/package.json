{
  "name": "xagent",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/src/main.js",
  "types": "./dist/src/main.d.ts",
  "bin": {
    "xagent": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc && cp src/service/dispatch_manifest.generated.json dist/src/service/",
    "generate:dispatch-manifest": "npx tsx scripts/generate_dispatch_manifest.ts",
    "start": "node dist/src/main.js",
    "service-run": "node dist/src/service_main.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.25.76"
  }
}
