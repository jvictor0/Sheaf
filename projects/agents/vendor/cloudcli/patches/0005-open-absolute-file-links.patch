@@ -0,0 +1,27 @@
+import { describe, expect, it } from 'vitest';
+
+import { resolveFileReference } from '@/modules/project-workspace/hooks/fileOpenResolver';
+
+describe('resolveFileReference', () => {
+  it('preserves an absolute path outside the selected project', () => {
+    const files = [
+      {
+        name: 'proposal.md',
+        path: '/workspace/current/.dev/worktree/other/openspec/changes/unrelated/proposal.md',
+      },
+    ];
+    const reference = '/workspace/sibling/openspec/changes/intended/proposal.md';
+
+    expect(resolveFileReference(files, reference)).toBe(reference);
+  });
+
+  it('still resolves relative references against project files', () => {
+    const files = [
+      { name: 'other.ts', path: '/workspace/current/src/other.ts' },
+      { name: 'target.ts', path: '/workspace/current/src/utils/target.ts' },
+    ];
+
+    expect(resolveFileReference(files, 'src/utils/target.ts'))
+      .toBe('/workspace/current/src/utils/target.ts');
+  });
+});
