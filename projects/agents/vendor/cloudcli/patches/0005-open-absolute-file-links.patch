index 00000000..cde41536
--- /dev/null
+++ b/src/modules/project-workspace/hooks/fileOpenResolver.ts
@@ -0,0 +1,38 @@
+export type FileReferenceCandidate = {
+  name: string;
+  path: string;
+};
+
+const normalize = (value: string): string => value.replace(/\\/g, '/');
+
+export const isAbsoluteFileReference = (value: string): boolean =>
+  value.startsWith('/') || /^[a-zA-Z]:[\\/]/.test(value) || value.startsWith('\\\\');
+
+// References inside chat messages are often bare basenames (`foo.ts`) or partial
+// paths (`utils/foo.ts`) rather than full paths, so match relative references by
+// path suffix and fall back to filename equality. Absolute paths are already
+// authoritative and must never be redirected to a same-named project file.
+export const resolveFileReference = (
+  files: FileReferenceCandidate[],
+  ref: string,
+): string => {
+  if (isAbsoluteFileReference(ref)) {
+    return ref;
+  }
+
+  const target = normalize(ref).replace(/^\.\//, '').replace(/^\/+/, '');
+  if (!target) {
+    return ref;
+  }
+
+  const suffixMatch = files.find((file) => {
+    const filePath = normalize(file.path);
+    return filePath === target || filePath.endsWith(`/${target}`);
+  });
+  if (suffixMatch) {
+    return suffixMatch.path;
+  }
+
+  const base = target.split('/').pop() || target;
+  return files.find((file) => file.name === base)?.path ?? ref;
+};
