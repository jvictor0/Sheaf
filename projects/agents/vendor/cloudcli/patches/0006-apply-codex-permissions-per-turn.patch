+// A loaded app-server thread keeps its configuration when rejoined. Only
+// turn/start overrides change the policy used for the next model turn.
+class LoadedThreadClient extends FakeAppServerClient {
+  effective = {
+    approvalPolicy: 'on-request',
+    approvalsReviewer: 'auto_review',
+    sandboxPolicy: { type: 'workspaceWrite' },
+  };
+
+  override async request(method: string, params: Record<string, unknown>) {
+    if (method === 'turn/start') {
+      for (const key of ['approvalPolicy', 'approvalsReviewer', 'sandboxPolicy'] as const) {
+        if (params[key] !== undefined) Object.assign(this.effective, { [key]: params[key] });
+      }
+    }
+    return super.request(method, params);
+  }
+}
+
+test('loaded thread changes effective permissions in both directions without restarting', async () => {
+  const client = new LoadedThreadClient();
+  setCodexAppServerClientForTests(client);
+  const context: ProviderRuntimeContext = {
+    resolveProviderSessionId: () => 'native-thread',
+    resolveResumeModel: async () => 'test-model',
+    getProviderModels: async () => ({ OPTIONS: [], DEFAULT: 'test-model' }),
+    normalizeMessage: () => [],
+    isProviderInstalled: async () => true,
+  };
+  try {
+    for (const mode of ['acceptEdits', 'bypassPermissions', 'acceptEdits', 'default', 'bypassPermissions']) {
+      await codexRuntime.run('next turn', {
+        sessionId: 'app-session', permissionMode: mode, cwd: process.cwd(),
+      }, { isWebSocketWriter: true, send: () => {} }, context);
+      assert.equal(client.effective.approvalPolicy, mode === 'bypassPermissions' ? 'never' : 'on-request');
+      assert.equal(client.effective.approvalsReviewer, mode === 'acceptEdits' ? 'auto_review' : 'user');
+      assert.equal(client.effective.sandboxPolicy.type, mode === 'bypassPermissions' ? 'dangerFullAccess' : 'workspaceWrite');
+    }
+  } finally {
+    setCodexAppServerClientForTests(null);
+  }
+});
