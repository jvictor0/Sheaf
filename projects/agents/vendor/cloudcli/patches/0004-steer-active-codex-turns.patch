+++ b/src/components/chat/utils/submissionMode.ts
@@ -0,0 +1,10 @@
+import type { Provider } from '../types/types';
+
+export type SubmissionMode = 'send' | 'steer' | 'queue';
+
+export function resolveSubmissionMode(provider: Provider, isLoading: boolean): SubmissionMode {
+  if (!isLoading) {
+    return 'send';
+  }
+  return provider === 'codex' ? 'steer' : 'queue';
+}
