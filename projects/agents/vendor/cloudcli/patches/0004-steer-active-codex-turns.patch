+export type SubmissionMode = 'send' | 'steer' | 'queue';
+
+export function resolveSubmissionMode(provider: LLMProvider, isLoading: boolean): SubmissionMode {
+  if (!isLoading) {
+    return 'send';
+  }
+  return provider === 'codex' ? 'steer' : 'queue';
+}
