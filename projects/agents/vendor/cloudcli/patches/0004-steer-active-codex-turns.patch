+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  queryCodex,
+  setCodexAppServerClientForTests,
+  steerCodexSession,
+} from './codex-runtime.provider.js';
+import { CodexSessionsProvider } from './codex-sessions.provider.js';
+
+class FakeAppServerClient {
+  constructor() {
+    this.listeners = new Set();
+    this.requests = [];
+  }
+
+  async request(method, params) {
+    this.requests.push({ method, params });
+    if (method === 'thread/start') {
+      return { thread: { id: 'provider-thread-1' } };
+    }
+    if (method === 'turn/start') {
+      return { turn: { id: 'turn-1' } };
+    }
+    if (method === 'turn/steer') {
+      return { turnId: 'turn-1' };
+    }
+    return {};
+  }
+
+  subscribe(listener) {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  emit(method, params) {
+    for (const listener of this.listeners) {
+      listener({ method, params });
+    }
+  }
+}
+
+const sessionsProvider = new CodexSessionsProvider();
+const runtimeContext = {
+  resolveProviderSessionId: () => null,
+  resolveResumeModel: async (_sessionId, requestedModel) => requestedModel,
+  getProviderModels: async () => ({
+    DEFAULT: 'gpt-test',
+    OPTIONS: [{ value: 'gpt-test', effort: { values: [{ value: 'high' }] } }],
+  }),
+  normalizeMessage: (raw, sessionId) => sessionsProvider.normalizeMessage(raw, sessionId),
+  isProviderInstalled: async () => true,
+};
+
+async function waitForRequest(client, method) {
+  for (let attempt = 0; attempt < 20; attempt += 1) {
+    const request = client.requests.find((candidate) => candidate.method === method);
+    if (request) {
+      return request;
+    }
+    await new Promise((resolve) => setImmediate(resolve));
+  }
+  throw new Error(`Timed out waiting for ${method}`);
+}
+
+test('Codex runtime starts through app-server and steers the active turn', async () => {
+  const client = new FakeAppServerClient();
+  setCodexAppServerClientForTests(client);
+  const messages = [];
+  const writer = {
+    isWebSocketWriter: true,
+    userId: null,
+    setSessionId(id) {
+      this.providerSessionId = id;
+    },
+    send(message) {
+      messages.push(message);
+    },
+  };
+
+  const running = queryCodex('Start', {
+    sessionId: 'app-session-1',
+    cwd: '/tmp/project',
+    model: 'gpt-test',
+    effort: 'high',
+    permissionMode: 'acceptEdits',
+  }, writer, runtimeContext);
+
+  const turnStart = await waitForRequest(client, 'turn/start');
+  assert.equal(turnStart.params.threadId, 'provider-thread-1');
+  assert.equal(turnStart.params.input[0].text, 'Start');
+  assert.equal(turnStart.params.effort, 'high');
+
+  const steered = await steerCodexSession('app-session-1', 'Focus on tests');
+  assert.equal(steered, true);
+  const steer = client.requests.find((request) => request.method === 'turn/steer');
+  assert.equal(steer.params.threadId, 'provider-thread-1');
+  assert.equal(steer.params.expectedTurnId, 'turn-1');
+  assert.equal(steer.params.input[0].text, 'Focus on tests');
+
+  client.emit('item/completed', {
+    threadId: 'provider-thread-1',
+    turnId: 'turn-1',
+    item: { type: 'agentMessage', id: 'message-1', text: 'Done' },
+  });
+  client.emit('turn/completed', {
+    threadId: 'provider-thread-1',
+    turn: { id: 'turn-1', status: 'completed', error: null },
+  });
+  await running;
+
+  assert.equal(writer.providerSessionId, 'provider-thread-1');
+  assert.ok(messages.some((message) => message.kind === 'session_created'));
+  assert.ok(messages.some((message) => message.kind === 'text' && message.content === 'Done'));
+  assert.ok(messages.some((message) => message.kind === 'complete'));
+  setCodexAppServerClientForTests(null);
+});
