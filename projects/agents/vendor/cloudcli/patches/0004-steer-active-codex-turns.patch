+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolveSubmissionMode } from './submissionMode';
+
+test('Codex submissions steer while a turn is running', () => {
+  assert.equal(resolveSubmissionMode('codex', true), 'steer');
+  assert.equal(resolveSubmissionMode('codex', false), 'send');
+});
+
+test('other providers preserve queued follow-ups while a turn is running', () => {
+  assert.equal(resolveSubmissionMode('claude', true), 'queue');
+  assert.equal(resolveSubmissionMode('cursor', true), 'queue');
+  assert.equal(resolveSubmissionMode('opencode', true), 'queue');
+});
