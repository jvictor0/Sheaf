+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { PassThrough } from 'node:stream';
+import test from 'node:test';
+
+import { CodexAppServerClient } from './codex-app-server-client.js';
+
+function createFakeProcess(onMessage) {
+  const child = new EventEmitter();
+  child.stdin = new PassThrough();
+  child.stdout = new PassThrough();
+  child.stderr = new PassThrough();
+  child.kill = () => {
+    queueMicrotask(() => child.emit('exit', 0, null));
+    return true;
+  };
+
+  let input = '';
+  child.stdin.on('data', (chunk) => {
+    input += String(chunk);
+    let newline = input.indexOf('\n');
+    while (newline !== -1) {
+      const line = input.slice(0, newline);
+      input = input.slice(newline + 1);
+      onMessage(JSON.parse(line), child);
+      newline = input.indexOf('\n');
+    }
+  });
+  return child;
+}
+
+test('CodexAppServerClient initializes, routes requests, and publishes notifications', async () => {
+  const received = [];
+  let child;
+  const client = new CodexAppServerClient({
+    cliEntrypoint: '/fake/codex.js',
+    spawnProcess(command, args) {
+      assert.equal(command, process.execPath);
+      assert.deepEqual(args, ['/fake/codex.js', 'app-server', '--stdio']);
+      child = createFakeProcess((message, processHandle) => {
+        received.push(message);
+        if (message.id !== undefined) {
+          processHandle.stdout.write(`${JSON.stringify({ id: message.id, result: { ok: message.method } })}\n`);
+        }
+      });
+      return child;
+    },
+  });
+
+  const notifications = [];
+  client.subscribe((notification) => notifications.push(notification));
+  const result = await client.request('thread/start', { model: 'gpt-test' });
+
+  assert.deepEqual(result, { ok: 'thread/start' });
+  assert.equal(received[0].method, 'initialize');
+  assert.equal(received[1].method, 'initialized');
+  assert.equal(received[2].method, 'thread/start');
+
+  child.stdout.write(`${JSON.stringify({ method: 'turn/started', params: { threadId: 'thread-1' } })}\n`);
+  assert.equal(notifications[0].method, 'turn/started');
+  client.close();
+});
+
+test('CodexAppServerClient rejects pending requests when app-server exits', async () => {
+  let child;
+  const client = new CodexAppServerClient({
+    cliEntrypoint: '/fake/codex.js',
+    spawnProcess() {
+      child = createFakeProcess((message, processHandle) => {
+        if (message.method === 'initialize') {
+          processHandle.stdout.write(`${JSON.stringify({ id: message.id, result: {} })}\n`);
+        }
+      });
+      return child;
+    },
+  });
+
+  await client.start();
+  const pending = client.sendRequest('turn/steer', {});
+  child.stderr.write('boom');
+  child.emit('exit', 1, null);
+
+  await assert.rejects(pending, /code 1: boom/);
+});
diff --git a/server/modules/providers/list/codex/codex-runtime.provider.test.js b/server/modules/providers/list/codex/codex-runtime.provider.test.js
new file mode 100644
index 0000000..b459d0b
--- /dev/null
+++ b/server/modules/providers/list/codex/codex-runtime.provider.test.js
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  queryCodex,
+  setCodexAppServerClientForTests,
+  steerCodexSession,
+} from './codex-runtime.provider.js';
+import { CodexSessionsProvider } from './codex-sessions.provider.js';
+
+class FakeAppServerClient {
+  constructor() {
+    this.listeners = new Set();
+    this.requests = [];
+  }
+
+  async request(method, params) {
+    this.requests.push({ method, params });
+    if (method === 'thread/start') {
+      return { thread: { id: 'provider-thread-1' } };
+    }
+    if (method === 'turn/start') {
+      return { turn: { id: 'turn-1' } };
+    }
+    if (method === 'turn/steer') {
+      return { turnId: 'turn-1' };
+    }
+    return {};
+  }
+
+  subscribe(listener) {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  emit(method, params) {
+    for (const listener of this.listeners) {
+      listener({ method, params });
+    }
+  }
+}
+
+const sessionsProvider = new CodexSessionsProvider();
+const runtimeContext = {
+  resolveProviderSessionId: () => null,
+  resolveResumeModel: async (_sessionId, requestedModel) => requestedModel,
+  getProviderModels: async () => ({
+    DEFAULT: 'gpt-test',
+    OPTIONS: [{ value: 'gpt-test', effort: { values: [{ value: 'high' }] } }],
+  }),
+  normalizeMessage: (raw, sessionId) => sessionsProvider.normalizeMessage(raw, sessionId),
+  isProviderInstalled: async () => true,
+};
+
+async function waitForRequest(client, method) {
+  for (let attempt = 0; attempt < 20; attempt += 1) {
+    const request = client.requests.find((candidate) => candidate.method === method);
+    if (request) {
+      return request;
+    }
+    await new Promise((resolve) => setImmediate(resolve));
+  }
+  throw new Error(`Timed out waiting for ${method}`);
+}
+
+test('Codex runtime starts through app-server and steers the active turn', async () => {
+  const client = new FakeAppServerClient();
+  setCodexAppServerClientForTests(client);
+  const messages = [];
+  const writer = {
+    isWebSocketWriter: true,
+    userId: null,
+    setSessionId(id) {
+      this.providerSessionId = id;
+    },
+    send(message) {
+      messages.push(message);
+    },
+  };
+
+  const running = queryCodex('Start', {
+    sessionId: 'app-session-1',
+    cwd: '/tmp/project',
+    model: 'gpt-test',
+    effort: 'high',
+    permissionMode: 'acceptEdits',
+  }, writer, runtimeContext);
+
+  const turnStart = await waitForRequest(client, 'turn/start');
+  assert.equal(turnStart.params.threadId, 'provider-thread-1');
+  assert.equal(turnStart.params.input[0].text, 'Start');
+  assert.equal(turnStart.params.effort, 'high');
+
+  const steered = await steerCodexSession('app-session-1', 'Focus on tests');
+  assert.equal(steered, true);
+  const steer = client.requests.find((request) => request.method === 'turn/steer');
+  assert.equal(steer.params.threadId, 'provider-thread-1');
+  assert.equal(steer.params.expectedTurnId, 'turn-1');
+  assert.equal(steer.params.input[0].text, 'Focus on tests');
+
+  client.emit('item/completed', {
+    threadId: 'provider-thread-1',
+    turnId: 'turn-1',
+    item: { type: 'agentMessage', id: 'message-1', text: 'Done' },
+  });
+  client.emit('turn/completed', {
+    threadId: 'provider-thread-1',
+    turn: { id: 'turn-1', status: 'completed', error: null },
+  });
+  await running;
+
+  assert.equal(writer.providerSessionId, 'provider-thread-1');
+  assert.ok(messages.some((message) => message.kind === 'session_created'));
+  assert.ok(messages.some((message) => message.kind === 'text' && message.content === 'Done'));
+  assert.ok(messages.some((message) => message.kind === 'complete'));
+  setCodexAppServerClientForTests(null);
+});
diff --git a/src/components/chat/utils/submissionMode.ts b/src/components/chat/utils/submissionMode.ts
