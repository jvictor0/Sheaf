+
+/** Persistent app-server transport used while Codex turns may be steered. */
+export class CodexSteeringClient {
+  constructor({ spawnProcess = spawn, cliEntrypoint = resolveCodexLauncher() } = {}) {
+    this.spawnProcess = spawnProcess;
+    this.cliEntrypoint = cliEntrypoint;
+    this.child = null;
