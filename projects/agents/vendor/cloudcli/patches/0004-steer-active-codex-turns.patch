index 0000000..6496ad9
--- /dev/null
+++ b/server/modules/providers/list/codex/codex-app-server-client.js
@@ -0,0 +1,161 @@
+import { spawn } from 'node:child_process';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import readline from 'node:readline';
+
+const require = createRequire(import.meta.url);
+
+export function resolveCodexCliEntrypoint() {
+  const packagePath = require.resolve('@openai/codex/package.json');
+  return path.join(path.dirname(packagePath), 'bin', 'codex.js');
+}
+
+export class CodexAppServerClient {
+  constructor({ spawnProcess = spawn, cliEntrypoint = resolveCodexCliEntrypoint() } = {}) {
+    this.spawnProcess = spawnProcess;
+    this.cliEntrypoint = cliEntrypoint;
+    this.child = null;
+    this.nextRequestId = 1;
+    this.pendingRequests = new Map();
+    this.notificationListeners = new Set();
+    this.startPromise = null;
+    this.stderr = '';
+  }
+
+  start() {
+    if (!this.startPromise) {
+      this.startPromise = this.startInternal();
+    }
+    return this.startPromise;
+  }
+
+  async startInternal() {
+    const child = this.spawnProcess(process.execPath, [this.cliEntrypoint, 'app-server', '--stdio'], {
+      env: process.env,
+      stdio: ['pipe', 'pipe', 'pipe'],
+    });
+    this.child = child;
+
+    child.stderr?.on('data', (chunk) => {
+      this.stderr = `${this.stderr}${String(chunk)}`.slice(-16_384);
+    });
+    child.once('error', (error) => this.handleExit(error));
+    child.once('exit', (code, signal) => {
+      const detail = signal ? `signal ${signal}` : `code ${code ?? 1}`;
+      const stderr = this.stderr.trim();
+      this.handleExit(new Error(`Codex app-server exited with ${detail}${stderr ? `: ${stderr}` : ''}`));
+    });
+
+    if (!child.stdout || !child.stdin) {
+      throw new Error('Codex app-server process is missing stdio');
+    }
+
+    const lines = readline.createInterface({ input: child.stdout, crlfDelay: Infinity });
+    lines.on('line', (line) => this.handleLine(line));
+
+    await this.sendRequest('initialize', {
+      clientInfo: {
+        name: 'cloudcli',
+        title: 'CloudCLI',
+        version: '1.37.2',
+      },
+    });
+    this.sendNotification('initialized', {});
+  }
+
+  handleLine(line) {
+    let message;
+    try {
+      message = JSON.parse(line);
+    } catch (error) {
+      console.warn('[Codex] Ignoring malformed app-server message:', error);
+      return;
+    }
+
+    if (message.id !== undefined && this.pendingRequests.has(message.id)) {
+      const pending = this.pendingRequests.get(message.id);
+      this.pendingRequests.delete(message.id);
+      if (message.error) {
+        pending.reject(new Error(message.error.message || `Codex app-server request failed: ${pending.method}`));
+      } else {
+        pending.resolve(message.result);
+      }
+      return;
+    }
+
+    if (message.id !== undefined && message.method) {
+      this.write({
+        id: message.id,
+        error: {
+          code: -32601,
+          message: `CloudCLI cannot handle Codex app-server request "${message.method}"`,
+        },
+      });
+      return;
+    }
+
+    if (message.method) {
+      for (const listener of this.notificationListeners) {
+        listener(message);
+      }
+    }
+  }
+
+  handleExit(error) {
+    if (!this.child) {
+      return;
+    }
+    this.child = null;
+    this.startPromise = null;
+    for (const pending of this.pendingRequests.values()) {
+      pending.reject(error);
+    }
+    this.pendingRequests.clear();
+    for (const listener of this.notificationListeners) {
+      listener({ method: 'cloudcli/app-server-error', params: { error } });
+    }
+  }
+
+  write(message) {
+    if (!this.child?.stdin?.writable) {
+      throw new Error('Codex app-server is not running');
+    }
+    this.child.stdin.write(`${JSON.stringify(message)}\n`);
+  }
+
+  sendRequest(method, params) {
+    const id = this.nextRequestId++;
+    return new Promise((resolve, reject) => {
+      this.pendingRequests.set(id, { method, resolve, reject });
+      try {
+        this.write({ method, id, params });
+      } catch (error) {
+        this.pendingRequests.delete(id);
+        reject(error);
+      }
+    });
+  }
+
+  sendNotification(method, params) {
+    this.write({ method, params });
+  }
+
+  async request(method, params) {
+    await this.start();
+    return this.sendRequest(method, params);
+  }
+
+  subscribe(listener) {
+    this.notificationListeners.add(listener);
+    return () => this.notificationListeners.delete(listener);
+  }
+
+  close() {
+    const child = this.child;
+    if (!child) {
+      return;
+    }
+    child.kill();
+    this.handleExit(new Error('Codex app-server client closed'));
+  }
+}
